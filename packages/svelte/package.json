{
  "name": "@scenelinear/svelte",
  "version": "0.1.0",
  "description": "Svelte 5 components for the scenelinear ACES web player (viewer, scopes, transport, panels).",
  "license": "Apache-2.0",
  "type": "module",
  "svelte": "./src/lib/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./tokens.css": "./src/lib/tokens.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-package -i src/lib -o dist"
  },
  "peerDependencies": {
    "svelte": "^5.40.0"
  },
  "dependencies": {
    "@scenelinear/core": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22",
    "@webgpu/types": "^0.1.74",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "publishConfig": {
    "svelte": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./tokens.css": "./dist/tokens.css"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hitaboy/scenelinear.git",
    "directory": "packages/svelte"
  }
}
