{
  "name": "@scenegrade/core",
  "version": "0.1.0",
  "description": "Headless WebGPU engine for colour grading and ACES-managed playback of EXR, ProRes and video: node grade, colour pipeline, scopes, overlays and frame-accurate playback.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./color": {
      "types": "./src/color/index.ts",
      "default": "./src/color/index.ts"
    },
    "./grade": {
      "types": "./src/grade/index.ts",
      "default": "./src/grade/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@scenegrade/exr-wasm": "workspace:*",
    "@mediabunny/prores": "^1.66.4",
    "mediabunny": "^1.66.1"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "@types/node": "^26.6.10",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./color": {
        "types": "./dist/color/index.d.ts",
        "default": "./dist/color/index.js"
      },
      "./grade": {
        "types": "./dist/grade/index.d.ts",
        "default": "./dist/grade/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hitaboy/scenegrade.git",
    "directory": "packages/core"
  },
  "keywords": [
    "color-grading",
    "colour-grading",
    "aces",
    "exr",
    "openexr",
    "prores",
    "webgpu",
    "color-management",
    "ocio",
    "video-player",
    "scopes",
    "vfx"
  ]
}
